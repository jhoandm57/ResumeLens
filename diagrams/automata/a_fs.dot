digraph A_FS {
    rankdir=LR;
    node [shape=circle, style=filled, fillcolor="#dbe8f7", fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];
    start [shape=point, style=invis];
    q6 [shape=doublecircle, fillcolor="#d5ecd4"];
    start -> q0;
    q0 -> q1 [label="JAVASCRIPT"];
    q0 -> q1 [label="TYPESCRIPT"];
    q1 -> q2 [label="REACT"];
    q1 -> q2 [label="ANGULAR"];
    q1 -> q2 [label="VUE"];
    q2 -> q3 [label="NODE_JS"];
    q2 -> q3 [label="DJANGO"];
    q2 -> q3 [label="SPRING_BOOT"];
    q3 -> q4 [label="REST_API"];
    q4 -> q5 [label="SQL"];
    q4 -> q5 [label="POSTGRESQL"];
    q4 -> q5 [label="NOSQL"];
    q3 -> q5 [label="SQL"];
    q3 -> q5 [label="POSTGRESQL"];
    q3 -> q5 [label="NOSQL"];
    q5 -> q6 [label="GIT"];
    q1 -> q1 [label="JAVASCRIPT\nTYPESCRIPT"];
    q2 -> q2 [label="REACT\nANGULAR\nVUE"];
    q3 -> q3 [label="NODE_JS\nDJANGO\nSPRING_BOOT"];
    q5 -> q5 [label="SQL\nPOSTGRESQL\nNOSQL"];
}
