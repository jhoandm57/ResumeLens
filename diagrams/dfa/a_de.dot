    subgraph cluster_g4 {
        label="G4: Data integration (mandatory)";
        fontname="Helvetica"; fontsize=10;
        style=solid; color=gray50;
        q5 [shape=circle];
        q6 [shape=circle];
        q7 [shape=circle];
    }
