digraph A_DE {
    rankdir=LR;
    nodesep=0.5;
    ranksep=1.4;
    splines=true;
    node [shape=circle, fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=9];
    start [shape=point];
    start -> q0;
    subgraph cluster_g1 {
        label="G1: Language (mandatory)";
        fontname="Helvetica"; fontsize=10;
        style=solid; color=gray50;
        q1 [shape=circle];
        q2 [shape=circle];
    }
    subgraph cluster_g2 {
        label="G2: Processing (mandatory)";
        fontname="Helvetica"; fontsize=10;
