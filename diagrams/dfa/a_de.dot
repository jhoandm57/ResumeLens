    q3 -> q7 [label="DATA_PIPELINE"];
    q4 -> q5 [label="ETL"];
    q4 -> q6 [label="ELT"];
    q4 -> q7 [label="DATA_PIPELINE"];
    q5 -> q6 [label="ELT"];
    q5 -> q7 [label="DATA_PIPELINE"];
    q5 -> q8 [label="DATA_WAREHOUSING"];
    q5 -> q9 [label="POSTGRESQL"];
    q5 -> q10 [label="NOSQL"];
    q6 -> q7 [label="DATA_PIPELINE"];
