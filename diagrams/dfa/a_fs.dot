digraph A_FS {
    rankdir=LR;
    nodesep=0.5;
    ranksep=1.4;
    splines=true;
    node [shape=circle, fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=9];
    start [shape=point];
    start -> q0;
    subgraph cluster_g1 {
        label="G1: Frontend language (mandatory)";
        fontname="Helvetica"; fontsize=10;
        style=solid; color=gray50;
        q1 [shape=circle];
        q2 [shape=circle];
    }
    subgraph cluster_g2 {
        label="G2: Frontend framework (mandatory)";
        fontname="Helvetica"; fontsize=10;
        style=solid; color=gray50;
        q3 [shape=circle];
        q4 [shape=circle];
        q5 [shape=circle];
    }
    subgraph cluster_g3 {
        label="G3: Backend (mandatory)";
        fontname="Helvetica"; fontsize=10;
        style=solid; color=gray50;
        q6 [shape=circle];
        q7 [shape=circle];
        q8 [shape=circle];
    }
    subgraph cluster_g4 {
        label="G4: API (optional)";
        fontname="Helvetica"; fontsize=10;
        style=dashed; color=gray50;
        q9 [shape=circle];
    }
    subgraph cluster_g5 {
        label="G5: Database (mandatory)";
        fontname="Helvetica"; fontsize=10;
        style=solid; color=gray50;
        q10 [shape=circle];
        q11 [shape=circle];
        q12 [shape=circle];
    }
    subgraph cluster_g6 {
        label="G6: Version control (mandatory)";
        fontname="Helvetica"; fontsize=10;
        style=solid; color=gray50;
        q13 [shape=doublecircle];
    }
    q0 -> q1 [label="JAVASCRIPT"];
